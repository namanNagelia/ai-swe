# Pinned toolchain versions for the agent image.
# provision.sh verifies every download against these checksums.
# Bump a version and its checksums together; the image manifest written to
# /etc/rootorroute/image-manifest.json records what was installed.

UBUNTU_RELEASE=24.04

NODE_VERSION=24.22.1
NODE_SHA256_AMD64=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
NODE_SHA256_ARM64=dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e

GO_VERSION=1.27.3
GO_SHA256_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
GO_SHA256_ARM64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49

UV_VERSION=0.13.5
UV_SHA256_AMD64=f68d291c75783122dad58ab77def0e13f3233f358731db5d6d7e8715603b928f
UV_SHA256_ARM64=4bb69cf95ed13f23713bb7bc09f241896ea0c75b7c557e615a20604b82f9c403

GH_VERSION=2.103.0
GH_SHA256_AMD64=fdd768eb70f6409f80fcfa9f3a1c0adf0fc98d827ab3ce0bed2ac22762c5d786
GH_SHA256_ARM64=7f322df34e624d14f5ec0c4acb121fd6dfa14392fdbbd1066aa8e0a05ac3721e

# Python for the agent runtime is installed by uv into /opt/rootorroute.
PYTHON_VERSION=3.12

# Headless Chromium for web browsing. Keep in step with the Python `playwright`
# dependency so both use the same browser build.
PLAYWRIGHT_VERSION=1.64.0

# Rust: rustup verifies the toolchain against the channel manifest.
RUSTUP_VERSION=1.29.2
RUSTUP_SHA256_AMD64=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4
RUSTUP_SHA256_ARM64=a9c168dbea81a84671c6b7a5c1795cb0eb699020110d107ddfca427bd797e697
RUST_VERSION=1.99.1

BUN_VERSION=1.4.3
BUN_SHA256_AMD64=3e730528d89775f03f87f05c06787c4df4099d0a37f3f252e7b829cb23816e18
BUN_SHA256_ARM64=efa9813da5ed72423bf847f916e8d2c47c0d776add972354026a75e10da9aa21

DENO_VERSION=2.9.8
DENO_SHA256_AMD64=e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609
DENO_SHA256_ARM64=d49596c20b9788cf8f5d8ddf644103d4bde56ed239753f0bdb92ba9361d51905
