# Environment for rr-* services. Secrets never go here; rr-tools fetches them at call time.
# provision.sh appends proxy settings in allowlist egress mode, and DOCKER_HOST.
RR_HOME=/home/agent
RR_TOOLS_SOCKET=/run/rootorroute/tools.sock
RR_EXEC_USER=rr-exec
PLAYWRIGHT_BROWSERS_PATH=/opt/rootorroute/browsers
RUSTUP_HOME=/opt/rust/rustup
COREPACK_ENABLE_DOWNLOAD_PROMPT=0
DOTNET_CLI_TELEMETRY_OPTOUT=1
DOTNET_NOLOGO=1
PATH=/opt/rootorroute/venv/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
