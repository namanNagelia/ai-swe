[Unit]
Description=Root or Route supervisor (ticket intake, workers, resume)
After=rr-tools.service
Requires=rr-egress.service rr-tools.service
ConditionPathExists=/opt/rootorroute/venv/bin/rr-supervisor
# Kill switch: `systemctl stop rr-supervisor` stops intake and all workers.

[Service]
User=agent
Group=agent
EnvironmentFile=/etc/rootorroute/agent.env
ExecStart=/opt/rootorroute/venv/bin/rr-supervisor
WorkingDirectory=/home/agent
# Workers are child processes; stop them with the supervisor.
KillMode=mixed
TimeoutStopSec=60
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/agent
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
