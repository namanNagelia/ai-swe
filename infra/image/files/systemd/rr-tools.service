[Unit]
Description=Root or Route tool server (MCP on a Unix socket)
After=network-online.target rr-egress.service tinyproxy.service
Wants=network-online.target
Requires=rr-egress.service
# Inert until the agent package is installed into /opt/rootorroute.
ConditionPathExists=/opt/rootorroute/venv/bin/rr-tools

[Service]
User=agent
Group=agent
EnvironmentFile=/etc/rootorroute/agent.env
ExecStart=/opt/rootorroute/venv/bin/rr-tools
RuntimeDirectory=rootorroute
RuntimeDirectoryMode=0750
WorkingDirectory=/home/agent
Restart=always
RestartSec=2
# Not NoNewPrivileges: the tool server uses a scoped sudo rule to run
# shell commands as the rr-exec sandbox user.
ProtectSystem=strict
ReadWritePaths=/home/agent /run/rootorroute -/run/sudo
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
